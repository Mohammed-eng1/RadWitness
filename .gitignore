# ═══ أسرار الاعتماد — لا تُرفع أبداً ════════════════════════════
# القوالب (secrets.example.*) فقط هي التي تُرفع. انسخها للاسم الحقيقي واملأها.
secrets.py
secrets.h
.env
*.env
# يلتقط أي secrets.h/secrets.py في legacy/ أو firmware/ أيضاً (git يطابق بأي عمق)

# ═══ مخرجات بايثون ═══════════════════════════════════════════════
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
venv/
.venv/
env/

# ═══ بيانات التشغيل — يبقى المجلد، تُستثنى محتوياته ══════════════
missions/*.csv
logs/*
!logs/.gitkeep
captures/*.jpg
captures/*.jpeg
captures/*.png
!captures/.gitkeep
# ملفات المعايرة خاصة بكل جهاز/أرضية (لا تُرفع) — يبقى المجلد
profiles/calibration/*.json
!profiles/calibration/.gitkeep

# ═══ ملفات النظام والمحرر ════════════════════════════════════════
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.bak
*~
.vscode/
.idea/

# ثنائي اختبار البروتوكول (يُترجَم عند الحاجة — لا يُرفع)
firmware/controller_display/test_protocol
firmware/controller_display/test_protocol.exe

# ملفات الطباعة ثلاثية الأبعاد (نواتج تصميم لا كود — تُحفظ خارج المستودع)
*.3mf
*.gcode

# ═══ من RadWitness: مفاتيح التوقيع وسجلات المهمة ══════════════════
# مفاتيح التوقيع — لا تُرفع أبداً
keys/
*.key
# صريحاً (secrets.py أعلاه يطابقه بأي عمق أصلاً)
pi/secrets.py
# بيانات محلية ونواتج بناء
logs/
dist/
*.jsonl
*.seal
